<Window x:Class="LaserPilot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaserPilot" Height="900" Width="1440" MinWidth="1100" MinHeight="680"
        Style="{StaticResource DarkWindow}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" KeyDown="Window_KeyDown">
    <Grid x:Name="RootGrid">
        <DockPanel>

            <!-- Menu -->
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_New project" InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                    <MenuItem Header="_Open project…" InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                    <MenuItem x:Name="MenuRecent" Header="Open _recent"/>
                    <MenuItem Header="_Save project" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                    <MenuItem Header="Save project _as…" InputGestureText="Ctrl+Shift+S" Click="SaveProjectAs_Click"/>
                    <Separator/>
                    <MenuItem Header="_Import image or drawing…" InputGestureText="Ctrl+I" Click="Import_Click"/>
                    <MenuItem Header="_Export G-code (for the MicroSD card)…" Click="ExportGcode_Click"/>
                    <MenuItem Header="Run a G-code _file…" Click="RunGcodeFile_Click"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem x:Name="MenuUndo" Header="_Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
                    <MenuItem x:Name="MenuRedo" Header="_Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
                    <Separator/>
                    <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D" Click="Duplicate_Click"/>
                    <MenuItem Header="De_lete" InputGestureText="Del" Click="DeleteItem_Click"/>
                    <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Click="SelectAll_Click"/>
                    <Separator/>
                    <MenuItem Header="Rotate 90°" Click="Rotate90_Click"/>
                    <MenuItem Header="Center on the bed" Click="CenterItem_Click"/>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="🧪 _Material test…" Click="MaterialTest_Click"/>
                    <MenuItem Header="✒ _Trace image to vectors…" Click="Trace_Click"/>
                    <Separator/>
                    <MenuItem Header="🧙 Setup _Wizard…" Click="Wizard_Click"/>
                    <MenuItem Header="⚙ _GRBL settings…" Click="Settings_Click"/>
                    <MenuItem Header="🖥 Show _console" Click="ShowConsole_Click"/>
                </MenuItem>
                <MenuItem Header="_Machine">
                    <MenuItem Header="_Connect / disconnect" Click="Connect_Click"/>
                    <MenuItem Header="🏠 _Home (safe)" Click="Home_Click"/>
                    <MenuItem Header="🔓 _Unlock" Click="Unlock_Click"/>
                    <MenuItem Header="↺ _Reset" Click="Reset_Click"/>
                    <Separator/>
                    <MenuItem Header="⬚ _Frame the job" Click="Frame_Click"/>
                    <MenuItem Header="➤ _Go to origin" Click="GotoOrigin_Click"/>
                    <MenuItem Header="📍 _Set origin here" Click="SetOrigin_Click"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="🎓 _Start the tutorial" InputGestureText="F1" Click="Tutorial_Click"/>
                    <MenuItem x:Name="MenuTutorialChapters" Header="Tutorial _chapters"/>
                    <Separator/>
                    <MenuItem Header="OMTech B10 _setup guide" Click="OpenSetupGuide_Click"/>
                    <MenuItem Header="_Homing troubleshooting" Click="OpenHomingGuide_Click"/>
                    <MenuItem Header="Install the USB _driver (CH340)…" Click="DriverHelp_Click"/>
                    <MenuItem Header="Open the _error log folder" Click="OpenLogs_Click"/>
                    <Separator/>
                    <MenuItem Header="Check for _updates…" Click="CheckUpdates_Click"/>
                    <MenuItem Header="Update _settings…" Click="UpdateSettings_Click"/>
                    <MenuItem Header="How automatic updates _work" Click="OpenUpdatesGuide_Click"/>
                    <MenuItem Header="_About LaserPilot" Click="About_Click"/>
                </MenuItem>
            </Menu>

            <!-- Toolbar. STOP has its own column so it can never be squeezed out;
                 the other buttons wrap onto a second row on narrow screens. -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,1" Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="LaserPilot" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
                        <ComboBox x:Name="PortCombo" Width="230" VerticalAlignment="Center"
                                  ToolTip="The connection port. Your laser usually shows up as 'USB-SERIAL CH340' (marked ★)."/>
                        <Button x:Name="RefreshPortsBtn" Content="⟳" ToolTip="Refresh the port list (after plugging in the USB cable)" Click="RefreshPorts_Click" Width="32"/>
                        <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource AccentButton}" Click="Connect_Click" Width="104"
                                ToolTip="Connect to the laser over USB"/>
                        <ComboBox x:Name="ProfileCombo" Width="215" VerticalAlignment="Center" Margin="8,2,2,2"
                                  SelectionChanged="ProfileCombo_SelectionChanged" ToolTip="Which machine you're using"/>
                        <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="8,4"/>
                        <Button x:Name="ImportBtn" Content="📁 Import…" Click="Import_Click" ToolTip="Import a picture (PNG, JPG…) or a drawing (SVG, DXF). You can also drag files onto the bed."/>
                        <Button x:Name="ShapeBtn" Content="➕ Shape ▾" Click="Shape_Click" ToolTip="Add a rectangle, ellipse, line or star">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="▭ Rectangle" Click="AddRect_Click"/>
                                    <MenuItem Header="◯ Ellipse" Click="AddEllipse_Click"/>
                                    <MenuItem Header="─ Line" Click="AddLine_Click"/>
                                    <MenuItem Header="★ Star" Click="AddStar_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="TextBtn" Content="🅰 Text…" Click="AddText_Click" ToolTip="Add text in any installed font"/>
                        <Border Width="1" Background="{StaticResource PanelBorderBrush}" Margin="8,4"/>
                        <Button x:Name="WizardBtn" Content="🧙 Setup Wizard" Click="Wizard_Click" ToolTip="Guided first-time machine setup (strongly recommended)"/>
                        <Button x:Name="SettingsBtn" Content="⚙ GRBL" Click="Settings_Click" ToolTip="View and edit the controller's settings, with plain-language explanations"/>
                        <Button x:Name="TutorialBtn" Content="❓ Tutorial" Click="Tutorial_Click" ToolTip="Step-by-step guided tour of LaserPilot (F1). Restart it any time."/>
                    </WrapPanel>
                    <Button x:Name="EStopBtn" Grid.Column="1" Content="⛔ STOP" VerticalAlignment="Top" Margin="8,2,2,2"
                            Style="{StaticResource DangerButton}" FontSize="16" Width="124" Height="38"
                            ToolTip="Emergency stop: instantly halts all motion and turns the laser off (GRBL soft reset)"
                            Click="EStop_Click"/>
                </Grid>
            </Border>

            <!-- Update banner -->
            <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="{StaticResource InfoBannerBrush}" Padding="10,5" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButton}" Click="UpdateBannerClose_Click" ToolTip="Hide"/>
                    <Button DockPanel.Dock="Right" Content="Update now…" Style="{StaticResource AccentButton}" Padding="12,3" Click="UpdateBannerOpen_Click"/>
                    <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" Text="A new version of LaserPilot is available."/>
                </DockPanel>
            </Border>

            <!-- Alert banner (alarms, safety stops, lost connection) -->
            <Border x:Name="AlertBanner" DockPanel.Dock="Top" Background="{StaticResource WarnBannerBrush}" Padding="10,5" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource LinkButton}" Click="AlertClose_Click" ToolTip="Hide"/>
                    <Button x:Name="AlertActionBtn" DockPanel.Dock="Right" Padding="12,3" Click="AlertAction_Click" Visibility="Collapsed"/>
                    <TextBlock x:Name="AlertText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Status bar -->
            <StatusBar DockPanel.Dock="Bottom" Padding="4,2">
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="StateBadge" CornerRadius="4" Padding="9,2" Background="#FF55575F" MinWidth="110">
                            <TextBlock x:Name="StateText" Text="Disconnected" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="PosText" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"
                                   Text="Laser X —  Y —" ToolTip="Where the laser head is (work coordinates, mm)"/>
                        <TextBlock x:Name="MouseText" Margin="14,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"
                                   Foreground="{StaticResource SubtleTextBrush}" ToolTip="Mouse position on the bed (mm)"/>
                        <Border x:Name="LaserIndicator" Margin="14,0,0,0" CornerRadius="4" Padding="7,1" Background="{StaticResource DangerBrush}"
                                Visibility="Collapsed" ToolTip="The laser beam is switched on">
                            <TextBlock Text="LASER ON" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock x:Name="FirmwareText" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubtleTextBrush}"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="JobText" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ProgressBar x:Name="JobProgress" Width="200"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>

            <!-- Console -->
            <Expander x:Name="ConsoleExpander" DockPanel.Dock="Bottom" Header="Console (advanced)" IsExpanded="False"
                      Background="{StaticResource PanelBrush}">
                <DockPanel Height="190" Margin="6,0,6,6">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Copy all" Click="ConsoleCopy_Click" Width="78"/>
                        <Button DockPanel.Dock="Right" Content="Clear" Click="ConsoleClear_Click" Width="64"/>
                        <Button DockPanel.Dock="Right" Content="Send" Click="ConsoleSend_Click" Width="70"/>
                        <TextBox x:Name="ConsoleInput" FontFamily="Consolas" PreviewKeyDown="ConsoleInput_PreviewKeyDown"
                                 ToolTip="Type a GRBL command ($$, $H, G0 X10 …) and press Enter. Up/Down recalls earlier commands."/>
                    </DockPanel>
                    <ListBox x:Name="ConsoleList" FontFamily="Consolas" FontSize="12"
                             Background="#FF141519" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </DockPanel>
            </Expander>

            <!-- Main area -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="262"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="318"/>
                </Grid.ColumnDefinitions>

                <!-- Left: machine control -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox x:Name="MachineGroup" Header="MACHINE">
                            <StackPanel>
                                <Button x:Name="HomeBtn" Content="🏠 Home (safe)" Click="Home_Click" FontSize="14" Padding="10,8"
                                        ToolTip="Moves the head to its home corner so it knows exactly where it is. Runs safety checks first and stops automatically if anything goes wrong. Do this every time you switch the laser on."/>
                                <UniformGrid Columns="2">
                                    <Button x:Name="UnlockBtn" Content="🔓 Unlock" Click="Unlock_Click" ToolTip="Clears a 'Locked (alarm)' state ($X). Homing is better if you can."/>
                                    <Button x:Name="ResetBtn" Content="↺ Reset" Click="Reset_Click" ToolTip="Restarts the controller (GRBL soft reset)"/>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button x:Name="SetOriginBtn" Content="📍 Set origin" Click="SetOrigin_Click"
                                            ToolTip="Makes the laser's current position X0 Y0. Only needed on machines that can't home."/>
                                    <Button x:Name="GotoOriginBtn" Content="➤ Go to 0,0" Click="GotoOrigin_Click" ToolTip="Move the head to X0 Y0 (laser off)"/>
                                </UniformGrid>
                                <ToggleButton x:Name="AirBtn" Content="💨 Air assist" Click="AirAssist_Click"
                                              ToolTip="Switches the air assist output on/off (M8/M9) — only works if the air pump is plugged into the controller."/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="JogGroup" Header="MOVE THE LASER">
                            <StackPanel>
                                <UniformGrid Columns="3" Height="132">
                                    <Border/>
                                    <Button Content="▲" FontSize="18" Click="JogYPlus_Click" ToolTip="Move away from you (Y+)"/>
                                    <Border/>
                                    <Button Content="◀" FontSize="18" Click="JogXMinus_Click" ToolTip="Move left (X−)"/>
                                    <Button Content="■" FontSize="13" Click="JogCancel_Click" ToolTip="Stop moving"/>
                                    <Button Content="▶" FontSize="18" Click="JogXPlus_Click" ToolTip="Move right (X+)"/>
                                    <Border/>
                                    <Button Content="▼" FontSize="18" Click="JogYMinus_Click" ToolTip="Move toward you (Y−)"/>
                                    <Border/>
                                </UniformGrid>
                                <DockPanel Margin="0,4,0,0">
                                    <Label Content="Step" Width="46"/>
                                    <ComboBox x:Name="JogStepCombo" SelectionChanged="JogCombo_SelectionChanged" ToolTip="How far each click moves the head">
                                        <ComboBoxItem>0.1 mm</ComboBoxItem>
                                        <ComboBoxItem>1 mm</ComboBoxItem>
                                        <ComboBoxItem>10 mm</ComboBoxItem>
                                        <ComboBoxItem>50 mm</ComboBoxItem>
                                        <ComboBoxItem>100 mm</ComboBoxItem>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel>
                                    <Label Content="Speed" Width="46"/>
                                    <ComboBox x:Name="JogFeedCombo" SelectionChanged="JogCombo_SelectionChanged" ToolTip="How fast the head moves">
                                        <ComboBoxItem>500 mm/min</ComboBoxItem>
                                        <ComboBoxItem>2000 mm/min</ComboBoxItem>
                                        <ComboBoxItem>4000 mm/min</ComboBoxItem>
                                        <ComboBoxItem>8000 mm/min</ComboBoxItem>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="FocusGroup" Header="FOCUS / AIM (LOW-POWER DOT)">
                            <StackPanel>
                                <DockPanel>
                                    <Label Content="Power" Width="46"/>
                                    <Label Content="%" DockPanel.Dock="Right"/>
                                    <TextBox x:Name="PulsePowerBox" Text="1" ToolTip="Keep this very low (0.5–2 %) — just enough to see the dot"/>
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <Button x:Name="LaserOnBtn" Content="🔦 Laser on" Click="LaserOn_Click"
                                            ToolTip="Fires a faint dot so you can see where the laser is. Switches itself off after 30 seconds. WEAR YOUR GOGGLES."/>
                                    <Button x:Name="LaserOffBtn" Content="Laser off" Click="LaserOff_Click"/>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Focus the B10 with its focusing tool: rest it on the material, lower the laser onto it, tighten."/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Center: workspace canvas -->
                <Border x:Name="CanvasBorder" Grid.Column="1" Background="{StaticResource CanvasBgBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Margin="4" ClipToBounds="True">
                    <Grid>
                        <Canvas x:Name="WorkCanvas" Background="Transparent" Focusable="True"
                                MouseWheel="Canvas_MouseWheel"
                                MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp"
                                MouseLeave="Canvas_MouseLeave" SizeChanged="Canvas_SizeChanged"
                                LostMouseCapture="Canvas_LostMouseCapture"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="3" CornerRadius="6"
                                Background="#CC26272E" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="⤢ Fit" Click="ZoomFit_Click" Padding="8,3" ToolTip="Show the whole bed"/>
                                <Button Content="−" Click="ZoomOut_Click" Padding="9,3" ToolTip="Zoom out (or use the mouse wheel)"/>
                                <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center"/>
                                <Button Content="+" Click="ZoomIn_Click" Padding="9,3" ToolTip="Zoom in"/>
                                <ToggleButton x:Name="PreviewToggle" Content="🖼 Engraving preview" Click="PreviewToggle_Click"
                                              ToolTip="Show images the way the laser will actually burn them (dithered dots)"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="CanvasHint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,10"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="12" IsHitTestVisible="False"
                                   Text="Drag to move · corner squares resize · right-drag or middle-drag pans · wheel zooms · right-click for more"/>
                    </Grid>
                </Border>

                <!-- Right: design + job -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <GroupBox x:Name="DesignGroup" Header="DESIGN">
                            <StackPanel>
                                <ListBox x:Name="ItemsList" Height="132" SelectionMode="Extended"
                                         SelectionChanged="ItemsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                <UniformGrid Columns="3">
                                    <Button Content="⧉ Copy" Click="Duplicate_Click" ToolTip="Duplicate the selection (Ctrl+D)"/>
                                    <Button Content="⟳ 90°" Click="Rotate90_Click" ToolTip="Rotate 90°"/>
                                    <Button Content="🗑 Delete" Click="DeleteItem_Click" ToolTip="Delete the selection (Del)"/>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button Content="Center on bed" Click="CenterItem_Click"/>
                                    <Button x:Name="TraceBtn" Content="✒ Trace image…" Click="Trace_Click"
                                            ToolTip="Turn the selected image into cuttable vector outlines"/>
                                </UniformGrid>
                                <TextBlock Text="Align to the bed:" Style="{StaticResource Caption}"/>
                                <UniformGrid Columns="6">
                                    <Button Content="⇤" Click="AlignL_Click" ToolTip="Align left" Padding="4,4"/>
                                    <Button Content="↔" Click="AlignCX_Click" ToolTip="Center horizontally" Padding="4,4"/>
                                    <Button Content="⇥" Click="AlignR_Click" ToolTip="Align right" Padding="4,4"/>
                                    <Button Content="⤒" Click="AlignT_Click" ToolTip="Align top (rear)" Padding="4,4"/>
                                    <Button Content="↕" Click="AlignCY_Click" ToolTip="Center vertically" Padding="4,4"/>
                                    <Button Content="⤓" Click="AlignB_Click" ToolTip="Align bottom (front)" Padding="4,4"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="PositionGroup" Header="POSITION &amp; SIZE (mm)">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Label Content="X" Width="26"/><TextBox x:Name="ItemX" Grid.Column="1" LostFocus="ItemProp_Changed" KeyDown="PropBox_KeyDown"/>
                                    <Label Content="Y" Grid.Column="2" Width="26"/><TextBox x:Name="ItemY" Grid.Column="3" LostFocus="ItemProp_Changed" KeyDown="PropBox_KeyDown"/>
                                    <Label Content="W" Grid.Row="1"/><TextBox x:Name="ItemW" Grid.Row="1" Grid.Column="1" LostFocus="ItemProp_Changed" KeyDown="PropBox_KeyDown"/>
                                    <Label Content="H" Grid.Row="1" Grid.Column="2"/><TextBox x:Name="ItemH" Grid.Row="1" Grid.Column="3" LostFocus="ItemProp_Changed" KeyDown="PropBox_KeyDown"/>
                                    <Label Content="Rot°" Grid.Row="2"/><TextBox x:Name="ItemRot" Grid.Row="2" Grid.Column="1" LostFocus="ItemProp_Changed" KeyDown="PropBox_KeyDown"/>
                                    <CheckBox x:Name="KeepAspect" Content="Lock aspect" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                              IsChecked="True" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="SelectionInfo" Style="{StaticResource Caption}" Visibility="Collapsed"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="LaserGroup" Header="LASER SETTINGS">
                            <StackPanel>
                                <DockPanel x:Name="ModeRow">
                                    <Label Content="Mode" Width="84"/>
                                    <ComboBox x:Name="ModeCombo" SelectionChanged="OpProp_Changed"
                                              ToolTip="Line: follows the outline (cutting, scoring). Fill: engraves the whole inside (text, logos). Fill + Line: both, for a crisp edge."/>
                                </DockPanel>
                                <DockPanel>
                                    <Label Content="Material" Width="84"/>
                                    <Button x:Name="SavePresetBtn" DockPanel.Dock="Right" Content="★" Padding="7,3" Click="SavePreset_Click"
                                            ToolTip="Save the current speed/power as your own material preset"/>
                                    <ComboBox x:Name="PresetCombo" SelectionChanged="Preset_SelectionChanged"
                                              ToolTip="Material presets for a 10W diode laser — starting points. Always test on a scrap piece first."/>
                                </DockPanel>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Label Content="Speed mm/min" ToolTip="How fast the head moves while burning. Slower = darker / deeper."/>
                                    <TextBox x:Name="OpSpeed" Grid.Column="1" LostFocus="OpProp_Changed" KeyDown="PropBox_KeyDown"/>
                                    <Label Content="Power %" Grid.Row="1" ToolTip="How strong the beam is. Higher = darker / deeper."/>
                                    <TextBox x:Name="OpPower" Grid.Row="1" Grid.Column="1" LostFocus="OpProp_Changed" KeyDown="PropBox_KeyDown"/>
                                    <Label Content="Passes" Grid.Row="2" ToolTip="How many times to repeat. Thick material is cut with several passes."/>
                                    <TextBox x:Name="OpPasses" Grid.Row="2" Grid.Column="1" LostFocus="OpProp_Changed" KeyDown="PropBox_KeyDown"/>
                                    <Label x:Name="OpIntervalLabel" Content="Line gap mm" Grid.Row="3"
                                           ToolTip="Distance between engraving lines. 0.08–0.1 mm suits the B10's 0.07 mm spot."/>
                                    <TextBox x:Name="OpInterval" Grid.Row="3" Grid.Column="1" LostFocus="OpProp_Changed" KeyDown="PropBox_KeyDown"/>
                                </Grid>
                                <DockPanel x:Name="DitherRow" Margin="0,2,0,0">
                                    <Label Content="Image mode" Width="84"/>
                                    <ComboBox x:Name="OpDither" SelectionChanged="OpProp_Changed"
                                              ToolTip="Dither modes (Floyd–Steinberg, Jarvis, Stucki, Atkinson, Ordered) turn photos into fine dots — best for photos. Grayscale varies the power — best for depth. Threshold is pure black/white — logos."/>
                                </DockPanel>
                                <CheckBox x:Name="OpInvert" Content="Invert (engrave the light areas)" Click="OpProp_Changed"
                                          ToolTip="For dark materials such as slate or black anodized aluminium, where the burn mark is lighter than the material"/>
                                <Expander x:Name="ImageAdjustExpander" Header="Image adjustments" Margin="0,2,0,0">
                                    <Grid Margin="4,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Label Content="Brightness" ToolTip="−100 … 100"/>
                                        <TextBox x:Name="OpBrightness" Grid.Column="1" LostFocus="OpProp_Changed" KeyDown="PropBox_KeyDown"/>
                                        <Label Content="Contrast" Grid.Row="1" ToolTip="−100 … 100"/>
                                        <TextBox x:Name="OpContrast" Grid.Row="1" Grid.Column="1" LostFocus="OpProp_Changed" KeyDown="PropBox_KeyDown"/>
                                        <Label Content="Gamma" Grid.Row="2" ToolTip="Above 1 lightens the mid-tones, below 1 darkens them"/>
                                        <TextBox x:Name="OpGamma" Grid.Row="2" Grid.Column="1" LostFocus="OpProp_Changed" KeyDown="PropBox_KeyDown"/>
                                        <Label Content="Min power %" Grid.Row="3" ToolTip="Grayscale mode: power used for the lightest shade that still gets burned"/>
                                        <TextBox x:Name="OpMinPower" Grid.Row="3" Grid.Column="1" LostFocus="OpProp_Changed" KeyDown="PropBox_KeyDown"/>
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="JobGroup" Header="JOB">
                            <StackPanel>
                                <DockPanel>
                                    <Label Content="Start from" Width="70"/>
                                    <ComboBox x:Name="OriginCombo" SelectionChanged="JobOption_Changed"
                                              ToolTip="Bed position: the job runs exactly where it sits on the grid (needs homing). Laser position: the job runs wherever the laser head is now.">
                                        <ComboBoxItem>Bed position (as on screen)</ComboBoxItem>
                                        <ComboBoxItem>Current laser position</ComboBoxItem>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel x:Name="AnchorRow" Visibility="Collapsed" Margin="0,2,0,2">
                                    <TextBlock Text="Which point of the design goes under the laser:" Style="{StaticResource Caption}" Width="150" DockPanel.Dock="Left"/>
                                    <UniformGrid x:Name="AnchorGrid" Columns="3" Width="84" Height="60" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <CheckBox x:Name="EngraveFirstCheck" Content="Engrave before cutting" Click="JobOption_Changed" IsChecked="True"
                                          ToolTip="Recommended: engraves and fills run first, so pieces can't shift or fall out before their engraving is done"/>
                                <CheckBox x:Name="AirAssistCheck" Content="Air assist on during the job" Click="JobOption_Changed"
                                          ToolTip="Switches the controller's air output on for the job (M8). Leave off if your pump has its own switch."/>
                                <CheckBox x:Name="FrameLaserCheck" Content="Frame with a faint laser dot" Click="JobOption_Changed"
                                          ToolTip="Frame with the laser at 1% so you can see the outline on the material. Off = the head moves with the laser off."/>
                                <UniformGrid Columns="2" Margin="0,4,0,0">
                                    <Button x:Name="FrameBtn" Content="⬚ Frame" Click="Frame_Click"
                                            ToolTip="Moves the head around the outline of the job (laser off) so you can check it fits on your material"/>
                                    <Button x:Name="PreviewBtn" Content="👁 Preview" Click="PreviewGcode_Click"
                                            ToolTip="See exactly what the laser will do, and how long it will take"/>
                                </UniformGrid>
                                <TextBlock x:Name="EstimateText" Style="{StaticResource Caption}" Text=""/>
                                <Button x:Name="StartBtn" Content="▶ START" Style="{StaticResource AccentButton}" FontSize="16" Padding="10,9" Click="Start_Click"/>
                                <UniformGrid Columns="2">
                                    <Button x:Name="PauseBtn" Content="⏸ Pause" Click="Pause_Click"/>
                                    <Button x:Name="StopBtn" Content="⏹ Stop" Click="StopJob_Click"
                                            ToolTip="Stops the job smoothly (keeps the machine's position). Use ⛔ STOP for an emergency."/>
                                </UniformGrid>
                                <StackPanel x:Name="OverridePanel" Margin="0,6,0,0" IsEnabled="False">
                                    <TextBlock Text="Adjust while running:" Style="{StaticResource Caption}"/>
                                    <DockPanel>
                                        <Label Content="Speed" Width="46"/>
                                        <TextBlock x:Name="FeedOverrideText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Slider x:Name="FeedOverrideSlider" Minimum="10" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                                ValueChanged="FeedOverride_Changed" ToolTip="Speed up or slow down the running job (10–200%)"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <Label Content="Power" Width="46"/>
                                        <TextBlock x:Name="PowerOverrideText" DockPanel.Dock="Right" Width="40" Text="100%" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Slider x:Name="PowerOverrideSlider" Minimum="10" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                                ValueChanged="PowerOverride_Changed" ToolTip="Make the running job lighter or darker (10–200% of the set power)"/>
                                    </DockPanel>
                                    <Button Content="Reset to 100%" Click="OverrideReset_Click" HorizontalAlignment="Right" Padding="8,3"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
