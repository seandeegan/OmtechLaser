<Window x:Class="LaserPilot.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GRBL Settings" Height="680" Width="900"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button Content="⟳ Read from machine" Click="Refresh_Click" DockPanel.Dock="Left" Width="160"/>
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Text="Double-click a Value to edit. Changes are written to the controller immediately after you confirm. Red rows can crash the machine if wrong."/>
        </DockPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="#FF17181C" Foreground="#FF1B1B1F" RowBackground="#FF26272E" AlternatingRowBackground="#FF2B2C33"
                  BorderBrush="{StaticResource PanelBorderBrush}" GridLinesVisibility="None"
                  HeadersVisibility="Column" CellEditEnding="Grid_CellEditEnding" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="$" Binding="{Binding Number}" IsReadOnly="True" Width="46"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="180"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#FFE8E8EC"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Risk}" Value="Dangerous">
                            <Setter Property="Foreground" Value="#FFFF9A9F"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Risk}" Value="Caution">
                            <Setter Property="Foreground" Value="#FFE5C888"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</Window>
