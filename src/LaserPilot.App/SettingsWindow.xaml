<Window x:Class="LaserPilot.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GRBL Settings" Height="700" Width="960"
        Style="{StaticResource DarkWindow}" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="⟳ Read from machine" Click="Refresh_Click" Width="160"/>
                <Button Content="💾 Back up…" Click="Backup_Click" ToolTip="Save every setting to a text file"/>
                <Button Content="↺ Restore…" Click="Restore_Click" ToolTip="Write settings back from a backup file (you'll see every change first)"/>
                <Button Content="📂 Backups folder" Click="OpenBackups_Click" ToolTip="LaserPilot backs up the settings automatically whenever they change"/>
            </StackPanel>
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}"
                       Text="Double-click a value to edit it. Red rows can crash the machine if wrong; yellow rows affect motion quality."/>
        </DockPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CellEditEnding="Grid_CellEditEnding" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="$" Binding="{Binding Number}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="190"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="70"/>
                <DataGridTextColumn Header="What it does" Binding="{Binding Description}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#FFE8E8EC"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Risk}" Value="Dangerous">
                            <Setter Property="Foreground" Value="#FFFF9A9F"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Risk}" Value="Caution">
                            <Setter Property="Foreground" Value="#FFE5C888"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </DockPanel>
</Window>
